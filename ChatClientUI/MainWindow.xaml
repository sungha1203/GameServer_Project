<Window x:Class="ChatClientUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client" Height="720" Width="1080" MinHeight="560" MinWidth="900"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#C8D1DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Chat Login" FontSize="30" FontWeight="Bold" Foreground="#111827"
                       HorizontalAlignment="Center"/>
            <TextBox Grid.Row="2" x:Name="NicknameTextBox" Text="tester" KeyDown="NicknameTextBox_KeyDown"/>
            <Button Grid.Row="4" x:Name="LoginButton" Content="Login" Click="LoginButton_Click"/>
            <TextBlock Grid.Row="6" x:Name="LoginStatusTextBlock" Text="172.30.1.48:7778"
                       Foreground="#64748B" HorizontalAlignment="Center"/>
        </Grid>

        <Grid x:Name="RoomListView" Visibility="Collapsed" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Rooms" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock x:Name="RoomListStatusTextBlock" Text="Choose a room"
                               Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="RefreshRoomsButton" Content="Refresh" Click="RefreshRoomsButton_Click"
                        DockPanel.Dock="Right" Width="110" HorizontalAlignment="Right"/>
            </DockPanel>

            <ListBox Grid.Row="2" x:Name="RoomListBox" ItemsSource="{Binding Rooms}"
                     MouseDoubleClick="RoomListBox_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1"
                                Padding="18" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Grid.Row="2" Text="{Binding UserCountText}" Foreground="#64748B"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Name="ChatRoomView" Visibility="Collapsed" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" Padding="14">
                <DockPanel>
                    <Button x:Name="LeaveButton" Content="Leave" Click="LeaveButton_Click"
                            DockPanel.Dock="Left" Width="100" Background="#DC2626"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock x:Name="CurrentRoomTextBlock" Text="Room" FontSize="24" FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="ChatStatusTextBlock" Text="" Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ListBox Grid.Row="2" x:Name="ChatListBox" ItemsSource="{Binding ChatLines}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Border MaxWidth="620" Padding="12,9" Background="{Binding BubbleBrush}"
                                    HorizontalAlignment="{Binding Alignment}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{Binding TitleBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{Binding MessageBrush}" FontSize="15"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="4" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="MessageTextBox" KeyDown="MessageTextBox_KeyDown"/>
                    <Button Grid.Column="2" x:Name="SendButton" Content="Send" Click="SendButton_Click" Width="100"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
